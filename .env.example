# Copie este arquivo para .env e preencha os valores reais somente no ambiente.
# Nunca versionar .env, senhas, tokens, chaves privadas ou dados de VPS.

NODE_ENV=development
SERVER_PORT=3001
# Enable only with loopback binding and a local proxy that overwrites X-Forwarded-For.
TRUST_PROXY_LOOPBACK=false
APP_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3001
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
# Logos: limite fixo de 2 MB; diretorio padrao server/uploads/empresas.

AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_DATABASE=equilibrio_auth
AUTH_DB_SCHEMA=equilibrio_ti
AUTH_DB_USER=equilibrio_auth_user
AUTH_DB_PASSWORD=troque-esta-senha-local
AUTH_ADMIN_EMAIL=admin@equilibrioti.com.br
AUTH_ADMIN_PASSWORD=troque-esta-senha-inicial
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Chaves AES de 32 bytes em base64, exclusivas deste ambiente e fora do Git.
# Preencher no gerenciador de segredos; nao reutilizar JWT_SECRET.
TENANT_CREDENTIAL_ACTIVE_KEY=
TENANT_CREDENTIAL_KEYS={}
SEED_DEMO_TENANT=false
SEED_DEMO_USER_PASSWORD=

DB_HOST=sqlserver.local
DB_PORT=1433
DB_DATABASE=nome_da_base_cliente
DB_USER=usuario_sqlserver_cliente
DB_PASSWORD=troque-esta-senha-local
DB_ENCRYPT=false
DB_TRUST_CERT=true
